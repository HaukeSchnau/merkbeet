{
  "name": "merkbeet",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "pnpm exec expo start",
    "android": "pnpm exec expo start --android",
    "ios": "pnpm exec expo start --ios",
    "web": "pnpm exec expo start --web",
    "preview": "bun --preload ./scripts/preview/preload.ts ./scripts/preview/render.ts",
    "build:web": "pnpm exec expo export --platform web --output-dir dist",
    "server": "bun server/index.ts",
    "test": "vp test run",
    "setup:web": "pnpm exec setup-skia-web public",
    "icons": "bun --preload ./scripts/preview/preload.ts ./scripts/preview/icons.ts",
    "bench": "bun --preload ./scripts/preview/preload.ts ./scripts/preview/bench.ts",
    "check": "vp check"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "57.0.12",
    "@expo/ui": "57.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "57.0.15",
    "expo-file-system": "57.0.5",
    "expo-image-picker": "57.0.12",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "57.0.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.94.0",
    "@schnau/tsconfig": "^0.1.1",
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.2",
    "canvaskit-wasm": "0.41.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.0",
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ]
}
