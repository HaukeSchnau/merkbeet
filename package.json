{
  "name": "merkbeet",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "57.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "57.0.14",
    "expo-file-system": "57.0.4",
    "expo-image-picker": "57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.2",
    "canvaskit-wasm": "0.41.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "pnpm exec expo start",
    "android": "pnpm exec expo start --android",
    "ios": "pnpm exec expo start --ios",
    "web": "pnpm exec expo start --web",
    "preview": "bun --preload ./scripts/preview/preload.ts ./scripts/preview/render.ts",
    "typecheck": "pnpm exec tsc --noEmit",
    "build:web": "pnpm exec expo export --platform web --output-dir dist",
    "deploy:preview": "MERKBEET_BASE_URL=/merkbeet bun run build:web && rm -rf /srv/agent-share/merkbeet && mkdir -p /srv/agent-share/merkbeet && cp -r dist/. /srv/agent-share/merkbeet/ && chmod -R g+rX /srv/agent-share/merkbeet",
    "server": "bun server/index.ts",
    "test": "bun test"
  },
  "private": true,
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "packageManager": "pnpm@11.2.2"
}